{
  "name": "brandshield-server",
  "version": "0.1.0",
  "private": true,
  "description": "BrandShield.ai API (by Inkloom AI)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/run-migrations.js",
    "seed": "node src/db/run-seed.js",
    "create-admin": "node src/cli/create-admin.js",
    "test": "vitest run",
    "postinstall": "npm rebuild better-sqlite3 || echo 'Skipping better-sqlite3 rebuild – using fallback'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vitest": "^5.1.0"
  }
}
